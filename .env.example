# Environment configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Manual data paths
DATA_DIR=data
DOCS_V1_PATH=data/ct200_manual.pdf
DOCS_V2_PATH=data/ct200_manual_v2.pdf

# Database
DATABASE_URL=sqlite:///./ct200.db

# LLM Provider Configuration
# Set GEMINI_API_KEY to use Google Gemini for structured QA generation.
# If unset or empty, the system automatically falls back to the deterministic local QA generator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Logging
LOG_LEVEL=INFO

